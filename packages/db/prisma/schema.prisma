// ToyVerse — Prisma schema (раздел 5 ТЗ)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  parent
  child
}

enum ToyStatus {
  processing
  ready
  failed
}

enum FriendshipStatus {
  pending
  accepted
}

enum ReactionType {
  heart
  star
  laugh
}

enum JobKind {
  image_stylize
  model_3d
  bio_generate
}

enum JobStatus {
  queued
  running
  done
  failed
}

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  telegramId  String?  @unique
  displayName String
  role        UserRole @default(parent)
  createdAt   DateTime @default(now())

  familyId    String?
  family      Family?  @relation(fields: [familyId], references: [id])
  ownedFamily Family?  @relation("FamilyOwner")

  sessions    Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Family {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  owner     User     @relation("FamilyOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  members  User[]
  children ChildProfile[]
  invites  FamilyInvite[]
}

model FamilyInvite {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  code      String   @unique
  role      UserRole @default(parent)
  createdAt DateTime @default(now())
  usedAt    DateTime?
}

model ChildProfile {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name      String
  birthYear Int
  avatarUrl String?
  createdAt DateTime @default(now())

  toys Toy[]
}

model Toy {
  id                 String       @id @default(cuid())
  ownerChildId       String
  ownerChild         ChildProfile @relation(fields: [ownerChildId], references: [id], onDelete: Cascade)
  fullName           String
  species            String
  originalPhotoUrl   String
  processedImageUrl  String?
  model3dUrl         String?
  bio                String       @default("")
  personalityTraits  String[]
  catchphrases       String[]
  status             ToyStatus    @default(processing)
  createdAt          DateTime     @default(now())

  posts        Post[]
  comments     Comment[]
  reactions    Reaction[]
  friendshipsA Friendship[] @relation("ToyA")
  friendshipsB Friendship[] @relation("ToyB")
  jobs         ProcessingJob[]
}

model Friendship {
  id        String           @id @default(cuid())
  toyAId    String
  toyA      Toy              @relation("ToyA", fields: [toyAId], references: [id], onDelete: Cascade)
  toyBId    String
  toyB      Toy              @relation("ToyB", fields: [toyBId], references: [id], onDelete: Cascade)
  status    FriendshipStatus @default(pending)
  createdAt DateTime         @default(now())

  @@unique([toyAId, toyBId])
}

model Post {
  id            String   @id @default(cuid())
  authorToyId   String
  authorToy     Toy      @relation(fields: [authorToyId], references: [id], onDelete: Cascade)
  text          String
  mediaUrls     String[]
  generatedByAi Boolean  @default(false)
  createdAt     DateTime @default(now())

  comments  Comment[]
  reactions Reaction[]
}

model Comment {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorToyId String
  authorToy   Toy      @relation(fields: [authorToyId], references: [id], onDelete: Cascade)
  text        String
  createdAt   DateTime @default(now())
}

model Reaction {
  id        String       @id @default(cuid())
  postId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  toyId     String
  toy       Toy          @relation(fields: [toyId], references: [id], onDelete: Cascade)
  type      ReactionType @default(heart)
  createdAt DateTime     @default(now())

  @@unique([postId, toyId, type])
}

model ProcessingJob {
  id            String    @id @default(cuid())
  toyId         String
  toy           Toy       @relation(fields: [toyId], references: [id], onDelete: Cascade)
  kind          JobKind
  status        JobStatus @default(queued)
  providerJobId String?
  payload       Json?
  result        Json?
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
