# --- Database ---
DATABASE_URL="postgresql://toyverse:toyverse@localhost:5432/toyverse?schema=public"

# --- Redis (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
AUTH_SECRET="change-me"
RESEND_API_KEY=""
EMAIL_FROM="ToyVerse <hello@toyverse.local>"
APP_URL="http://localhost:3000"

# --- Telegram ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# --- Storage (S3-compatible) ---
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="toyverse"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --- AI providers ---
# LLM: anthropic | openai | mock
LLM_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Image stylize: replicate | mock
IMAGE_PROVIDER="mock"
REPLICATE_API_TOKEN=""
REPLICATE_MODEL=""

# 3D: meshy | tripo | mock | off
THREE_D_PROVIDER="off"
MESHY_API_KEY=""
TRIPO_API_KEY=""

# Feature flags
FEATURE_3D_ENABLED="false"
